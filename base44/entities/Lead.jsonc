{
  "name": "Lead",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom du lead"
    },
    "prenom": {
      "type": "string",
      "description": "Prénom du lead"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telephone": {
      "type": "string"
    },
    "entreprise": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "site_web",
        "recommandation",
        "linkedin",
        "salon",
        "appel_entrant",
        "ecran_led",
        "autre"
      ],
      "default": "site_web"
    },
    "statut": {
      "type": "string",
      "enum": [
        "nouveau",
        "contacte",
        "qualifie",
        "proposition",
        "gagne",
        "perdu"
      ],
      "default": "nouveau"
    },
    "valeur_estimee": {
      "type": "number",
      "description": "Valeur estimée en euros"
    },
    "notes": {
      "type": "string"
    },
    "date_relance": {
      "type": "string",
      "format": "date"
    },
    "external_source": {
      "type": "string",
      "description": "Système source externe, par exemple ecranlead"
    },
    "external_id": {
      "type": "string",
      "description": "Identifiant idempotent dans le système source"
    },
    "contrat_signe": {
      "type": "boolean",
      "default": false
    },
    "secteur": {
      "type": "string"
    },
    "source_metadata": {
      "type": "object",
      "description": "Métadonnées techniques de synchronisation"
    },
    "date_conversion_client": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "nom",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "collaborateur"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "collaborateur"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "collaborateur"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "collaborateur"
          ]
        }
      }
    }
  }
}
