# ============================================================
# JS-Innov.IA Cockpit — Environment Variables
# Les noms uniquement — JAMAIS de valeurs réelles dans ce fichier.
# ============================================================

# ─── Supabase: Auth & Assets (rzvvwcwyaddzsaattwqt) ──────────────
# [server-only] — JAMAIS exposée côté frontend
SUPABASE_URL=https://rzvvwcwyaddzsaattwqt.supabase.co
SUPABASE_ANON_KEY=
# [server-only] — Secret critique, rotation régulière
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Supabase: Business Data (gfjpryakxzdzwnazlsfz) ──────────────
# [server-only] — JAMAIS exposée côté frontend
SUPABASE_CRM_URL=https://gfjpryakxzdzwnazlsfz.supabase.co
SUPABASE_CRM_KEY=

# ─── Frontend (Vite — exposée dans le bundle, safe) ───────────────
# [frontend-safe] — clés publiques uniquement
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENT_KEY=
VITE_AGENT_URL=
VITE_AGENT_AUTH=
VITE_COCKPIT_WEBHOOK_URL=

# ─── Dropbox ─────────────────────────────────────────────────────
# [server-only]
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/Cockpit
DROPBOX_ACCESS_TOKEN=
# Digital Signage : racine dédiée (fallback vers DROPBOX_ROOT_PATH si non défini)
SIGNAGE_DROPBOX_ROOT_PATH=/Cockpit/Olivier-Trevis
# Namespace Dropbox pour Digital Signage (optionnel, pour la séparation de l'espace)
SIGNAGE_DROPBOX_NAMESPACE_ID=
# Dossier de publication automatique des releases signées Pixelium Player
PIXELIUM_DROPBOX_PLAYER_DIR=/Cockpit/Olivier-Trevis/Players/MXQ
# Migration Dropbox (activée : "enabled", sinon "disabled" par défaut)
SIGNAGE_DROPBOX_MIGRATION_20260903=disabled

# ─── OpenAI ──────────────────────────────────────────────────────
# [server-only]
OPENAI_API_KEY=

# ─── Railway ─────────────────────────────────────────────────────
# [server-only]
RAILWAY_TOKEN=
RAILWAY_API_TOKEN=

# ─── Email (IONOS) ───────────────────────────────────────────────
# [server-only]
EMAIL_PROXY_KEY=
EMAIL_JSINNOVIA_ADDRESS=
EMAIL_JSINNOVIA_PASSWORD=
EMAIL_ASSURANCES_ADDRESS=
EMAIL_ASSURANCES_PASSWORD=
EMAIL_STORE_ADDRESS=
EMAIL_STORE_PASSWORD=

# ─── Pixelium / Espace C : devis automatiques ───────────────────
# [server-only] Adresse Pixelium dédiée. Aucun fallback vers JS-Innov.IA.
PIXELIUM_EMAIL_ADDRESS=
PIXELIUM_EMAIL_PASSWORD=
PIXELIUM_EMAIL_FROM_NAME=Pixelium
PIXELIUM_REPLY_TO=
PIXELIUM_SMTP_HOST=smtp.ionos.fr
PIXELIUM_SMTP_PORT=465

# Prix en CENTIMES. Laisser vides jusqu'à confirmation écrite d'Olivier.
PIXELIUM_PRICE_MONTHLY_CENTS=
PIXELIUM_PRICE_ANNUAL_CENTS=
PIXELIUM_PRICE_FESTIVAL_CENTS=
# Valeur autorisée : HTVA ou TVAC
PIXELIUM_PRICE_TAX_MODE=

# Garde-fou : le devis à +35 min ne part que si cette variable est true ET
# si le prix correspondant + le régime TVA + l'adresse Pixelium sont configurés.
PIXELIUM_QUOTE_AUTOSEND_ENABLED=false

# Clé commune avec le site public pour POST /api/pixelium/request.
COMMERCE_BRIDGE_KEY=

# ─── Agent (jsinnovia-agent sur Railway) ─────────────────────────
# [server-only]
AGENT_API_KEY=
JSINNOVIA_AGENT_URL=
JSINNOVIA_AGENT_KEY=

# ─── GitHub ──────────────────────────────────────────────────────
# [server-only]
GITHUB_TOKEN=

# ─── AI Cost Control ────────────────────────────────────────────
# [server-only]
AI_COST_INGEST_KEY=

# ─── Security ────────────────────────────────────────────────────
# [server-only]
COCKPIT_URL=https://cockpit.jsinnovia.com
# URL envoyée dans les invitations du portail client Signage.
CLIENT_PORTAL_URL=https://olivier-signage-cockpit-production.up.railway.app
SIGNAGE_COMPARISON_TEMPLATE_URL=https://canva.link/vps9laitxuyp8c8

# ─── Twilio (optional) ──────────────────────────────────────────
# [server-only]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── API Port ────────────────────────────────────────────────────
API_PORT=3001

# SIGNELYA notifications (disabled until controlled acceptance test)
SIGNELYA_NOTIFICATIONS_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=1114555501730767
WHATSAPP_WABA_ID=882701644569495
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
