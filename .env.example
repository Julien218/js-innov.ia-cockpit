# JS-Innov.IA Cockpit — exemple de configuration
# Ne jamais placer une clé secrète dans une variable préfixée VITE_.

# ── Variables SERVEUR uniquement ─────────────────────────────────────────────
# Authentification cockpit / Supabase. La service-role ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_secret

# Origine HTTPS officielle de CE déploiement cockpit.
COCKPIT_URL=https://cockpit.example.com

# Backend JS-Innov.IA utilisé par /api/data et /api/insurance.
JSINNOVIA_AGENT_URL=https://your-agent.example.com
AGENT_API_KEY=replace_with_server_secret
# Alias serveur facultatif si nécessaire pour compatibilité.
JSINNOVIA_AGENT_KEY=

# Timeout du proxy Assurances en millisecondes.
INSURANCE_PROXY_TIMEOUT_MS=15000

# ── SMTP / IMAP IONOS — SERVEUR uniquement ──────────────────────────────────
# Les noms exacts utilisés par server-email.cjs doivent être configurés dans Railway.
# Ne jamais préfixer les mots de passe SMTP/IMAP par VITE_.

# ── Variables publiques Vite ─────────────────────────────────────────────────
# Uniquement des valeurs explicitement prévues pour être visibles dans le bundle navigateur.
VITE_BASE44_API_KEY=replace_only_if_this_is_a_public_workspace_key
VITE_COCKPIT_API_URL=https://cockpit.example.com
VITE_COCKPIT_WEBHOOK_URL=https://your-public-webhook.example.com
VITE_SUPABASE_URL=https://your-public-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_public_anon_key
VITE_APP_ID=replace_with_public_app_id

# INTERDIT pour l'authentification backend :
# VITE_AGENT_KEY
# VITE_AGENT_AUTH
# VITE_AGENT_API_KEY
# Toute clé permettant x-agent-key / service-role / SMTP / IMAP.
