# JS-Innov.IA Cockpit — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles

# ── Agent jsinnovia-agent (Railway) ──────────────────────────────────────────
# URL du service backend Railway (proxy Supabase)
VITE_AGENT_URL=https://jsinnovia-agent-production.up.railway.app

# Clé d'auth pour x-agent-key header (legacy frontend — migration serveur prévue)
VITE_AGENT_KEY=your_agent_key_here

# Alias utilisé par base44Client.js (legacy frontend)
VITE_AGENT_AUTH=your_agent_key_here

# ── Page /agents-ia (Base44 Workspace API) ───────────────────────────────────
# Clé API workspace Base44 (legacy — ne pas utiliser pour les nouvelles intégrations)
VITE_BASE44_API_KEY=your_base44_workspace_api_key_here

# ── Cockpit API interne ───────────────────────────────────────────────────────
# URL du cockpit (pour les appels inter-services)
VITE_COCKPIT_API_URL=https://cockpit.jsinnovia.com
COCKPIT_URL=https://cockpit.jsinnovia.com

# Legacy frontend
VITE_AGENT_API_KEY=your_agent_key_here

# ── Webhook sync leads ────────────────────────────────────────────────────────
VITE_COCKPIT_WEBHOOK_URL=https://jsinnovia-agent-production.up.railway.app/webhook/leads

# ── Supabase ──────────────────────────────────────────────────────────────────
# Frontend : anon key uniquement.
VITE_SUPABASE_URL=https://rzvvwcwyaddzsaattwqt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Backend uniquement : ne jamais préfixer ces secrets avec VITE_.
SUPABASE_URL=https://rzvvwcwyaddzsaattwqt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key_here
# Alias accepté par le backend si vous utilisez la nouvelle clé secrète Supabase.
SUPABASE_SECRET_KEY=

# ── Base44 App ID ─────────────────────────────────────────────────────────────
VITE_APP_ID=69ff4dc771a2cdab275f8a00

# ── AI Cost Control — SERVEUR UNIQUEMENT ─────────────────────────────────────
# Secret partagé entre cockpit.jsinnovia.com et les services qui remontent l'usage IA.
# Générer une valeur aléatoire longue et ne jamais la préfixer par VITE_.
AI_COST_INGEST_KEY=replace_with_a_long_random_server_secret

# Optionnel : surcharge du catalogue de prix JSON si OpenAI modifie ses tarifs.
# Valeurs = USD / 1M tokens. Laisser vide pour utiliser le catalogue embarqué.
# AI_COST_PRICING_JSON={"gpt-5.6-terra":{"label":"GPT-5.6 Terra","input":2.5,"cachedInput":0.25,"output":15}}

# ── Agent Réseaux IA SaaS — SERVEUR UNIQUEMENT ───────────────────────────────
# Génération éditoriale. La clé OpenAI reste exclusivement sur Railway/backend.
OPENAI_API_KEY=your_openai_api_key_here
SOCIAL_TEXT_MODEL=gpt-5.6-terra

# Provisionnement sécurisé depuis le backend de jsinnovia.com après paiement.
# Ne jamais appeler cette route depuis le navigateur et ne jamais exposer cette clé en VITE_.
SOCIAL_PROVISIONING_KEY=replace_with_a_long_random_server_secret

# Recherche factuelle/sources : webhook fournisseur optionnel.
SOCIAL_RESEARCH_WEBHOOK_URL=
SOCIAL_RESEARCH_WEBHOOK_KEY=

# Génération vidéo : fournisseur interchangeable (xAI, pipeline interne, autre).
# Le fournisseur reçoit le storyboard et renvoie media_url ou appelle /api/social-agent/video-callback.
SOCIAL_VIDEO_GENERATOR_URL=
SOCIAL_VIDEO_GENERATOR_KEY=

# Publication réseaux : adaptateur serveur vers Meta/TikTok/YouTube/LinkedIn.
# Aucune publication n'est demandée avant validation humaine.
SOCIAL_PUBLISHER_URL=
SOCIAL_PUBLISHER_KEY=

# Twilio / WhatsApp Business pour envoyer la vidéo au validateur et recevoir VALID/EDIT/REFUS.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+32XXXXXXXXX

# ── Assurances-Dour — SERVEUR UNIQUEMENT ─────────────────────────────────────
# Ne jamais préfixer ces secrets avec VITE_.
EMAIL_ASSURANCES_ADDRESS=info@assurances-dour.be
EMAIL_PASSWORD_ASSURANCES=your_ionos_mailbox_password_here
EMAIL_ASSURANCES_IMAP_HOST=imap.ionos.fr
EMAIL_ASSURANCES_IMAP_PORT=993
JSINNOVIA_AGENT_URL=https://jsinnovia-agent-production.up.railway.app
AGENT_API_KEY=your_server_only_agent_key_here

# Synchronisation automatique : désactivée par défaut.
# L'analyse manuelle depuis l'onglet Assurances-Dour fonctionne sans l'activer.
INSURANCE_EMAIL_SYNC_ENABLED=false
INSURANCE_EMAIL_SYNC_INTERVAL_MS=300000
INSURANCE_EMAIL_SYNC_BATCH=25
INSURANCE_PROXY_TIMEOUT_MS=20000

# ── Coffre documentaire Dropbox — SERVEUR UNIQUEMENT ─────────────────────────
# Utiliser une app Dropbox scoped avec permissions minimales :
# files.content.read, files.content.write et files.metadata.read.
# Pour un accès permanent, utiliser OAuth offline + refresh token.
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token_here
# Option de développement uniquement : token court terme. Le refresh token est préféré.
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/JS-Innov.IA/Cockpit

# Index documentaire : les fichiers restent dans Dropbox, Supabase ne conserve que les métadonnées.
# Si le CRM utilise un projet Supabase séparé, renseigner ces deux variables.
SUPABASE_CRM_URL=https://your-crm-project.supabase.co
SUPABASE_CRM_KEY=your_server_only_crm_key_here

# SMTP : par défaut IONOS et validation TLS stricte.
# Ne mettre true qu'en dépannage temporaire contrôlé.
SMTP_ALLOW_INVALID_CERT=false
