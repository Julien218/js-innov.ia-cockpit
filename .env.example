# JS-Innov.IA Cockpit — exemple de configuration
# Ne placez aucune valeur réelle dans ce fichier.
# Les variables VITE_* sont intégrées au bundle navigateur et doivent rester publiques.

# ── Frontend public ───────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-public-project.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_ID=
VITE_COCKPIT_API_URL=http://localhost:3001

# ── Serveur Cockpit ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
COCKPIT_URL=http://localhost:5173

# Supabase serveur — ne jamais préfixer par VITE_
SUPABASE_URL=https://your-server-project.supabase.co
SUPABASE_SECRET_KEY=
# Alias temporaire accepté par certains modules historiques :
SUPABASE_SERVICE_ROLE_KEY=

# Proxy métier jsinnovia-agent
JSINNOVIA_AGENT_URL=https://your-agent-service.example
JSINNOVIA_AGENT_KEY=
# Compatibilité des routes email internes existantes
AGENT_API_KEY=

# Proxy email officiel HainoFlow / applications serveur-à-serveur
# Générer une nouvelle valeur aléatoire, distincte de AGENT_API_KEY.
EMAIL_PROXY_KEY=

# ── Boîtes IONOS ─────────────────────────────────────────────────────────────
EMAIL_JSINNOVIA_ADDRESS=info@example.com
EMAIL_PASSWORD=
EMAIL_ASSURANCES_ADDRESS=assurances@example.com
EMAIL_PASSWORD_ASSURANCES=
EMAIL_STORE_ADDRESS=store@example.com
EMAIL_PASSWORD_STORE=

# ── Assistant personnel ──────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Règles de sécurité ───────────────────────────────────────────────────────
# Interdit : VITE_AGENT_KEY, VITE_AGENT_AUTH, VITE_AGENT_API_KEY,
# VITE_BASE44_API_KEY, VITE_SUPABASE_SERVICE_ROLE_KEY et tout secret VITE_*.
# Les secrets sont configurés uniquement sur le service serveur Railway.
