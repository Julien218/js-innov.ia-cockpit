# ============================================================
# JS-Innov.IA Cockpit — Environment Variables
# Les noms uniquement — JAMAIS de valeurs réelles dans ce fichier.
# ============================================================

# ─── Supabase: Auth & Assets (rzvvwcwyaddzsaattwqt) ──────────────
# [server-only] — JAMAIS exposée côté frontend
SUPABASE_URL=https://rzvvwcwyaddzsaattwqt.supabase.co
SUPABASE_ANON_KEY=
# [server-only] — Secret critique, rotation régulière
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Supabase: Business Data (gfjpryakxzdzwnazlsfz) ──────────────
# [server-only] — JAMAIS exposée côté frontend
SUPABASE_CRM_URL=https://gfjpryakxzdzwnazlsfz.supabase.co
SUPABASE_CRM_KEY=

# ─── Frontend (Vite — exposée dans le bundle, safe) ───────────────
# [frontend-safe] — clés publiques uniquement
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AGENT_KEY=
VITE_AGENT_URL=
VITE_AGENT_AUTH=
VITE_COCKPIT_WEBHOOK_URL=
VITE_AVATAR_FACTORY_URL=http://127.0.0.1:8791
VITE_AVATAR_REFERENCE_UPLOAD_URL=http://127.0.0.1:8792
VITE_AVATAR_PREVIEW_URL=http://127.0.0.1:8793

# ─── Dropbox ─────────────────────────────────────────────────────
# [server-only]
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_PATH=/Cockpit
DROPBOX_ACCESS_TOKEN=

# ─── OpenAI ──────────────────────────────────────────────────────
# [server-only]
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=

# ─── Railway ─────────────────────────────────────────────────────
# [server-only]
RAILWAY_TOKEN=
RAILWAY_API_TOKEN=
# Endpoint optionnel retournant le coût monétaire Railway pour un projet/période.
# Le JSON doit contenir accounting_status="actual", currency et verification_ref.
RAILWAY_COSTS_ENDPOINT=

# ─── Email (IONOS) ───────────────────────────────────────────────
# [server-only]
EMAIL_PROXY_KEY=
EMAIL_JSINNOVIA_ADDRESS=
EMAIL_JSINNOVIA_PASSWORD=
EMAIL_ASSURANCES_ADDRESS=
EMAIL_ASSURANCES_PASSWORD=
EMAIL_STORE_ADDRESS=
EMAIL_STORE_PASSWORD=

# ─── Agent (jsinnovia-agent sur Railway) ─────────────────────────
# [server-only]
AGENT_API_KEY=
JSINNOVIA_AGENT_URL=
JSINNOVIA_AGENT_KEY=

# ─── Agents métier Base44 ────────────────────────────────────────
# [server-only] — utilisé par le Companion pour déléguer aux agents historiques des sites.
# Ne jamais remplacer par une variable VITE_* : la clé ne doit pas entrer dans le bundle frontend.
BASE44_API_KEY=
BASE44_AGENT_URL=https://app.base44.com/api/agents
# Nombre maximum de spécialistes consultés automatiquement sur une même demande (1 à 3).
COMPANION_MAX_SPECIALISTS=2

# ─── Banque-Carrefour des Entreprises (BCE) ────────────────────
# [server-only] — adaptateur JSON raccordé au Service web Public Search officiel.
# L'accès officiel doit être enregistré auprès du SPF Economie. Ne pas scraper Public Search.
BCE_LOOKUP_URL=
BCE_LOOKUP_TOKEN=

# ─── GitHub ──────────────────────────────────────────────────────
# [server-only]
GITHUB_TOKEN=
# Jeton finement limité avec Plan(read) pour un compte personnel ou Administration(read) pour une organisation.
GITHUB_BILLING_TOKEN=

# ─── AI Cost Control / Refacturation ─────────────────────────────
# [server-only]
AI_COST_INGEST_KEY=
AI_COST_PRICING_JSON=
# Conversion utilisée lors de l'import des coûts USD -> EUR. Les deux valeurs sont obligatoires.
# Exemple de source : "ECB 2026-08 monthly accounting rate".
BILLING_EUR_PER_USD=
BILLING_FX_SOURCE=
# 0 par défaut : la marge commerciale se configure par client dans client_billing_rules.
CLIENT_COST_DEFAULT_MARKUP_PERCENT=0
# IA locale : puissance mesurée, tarif énergie et amortissement/maintenance machine par heure.
# Tant qu'une valeur est absente ou nulle, le Cockpit bloque le calcul au lieu d'afficher 0 €.
LOCAL_AI_POWER_WATTS=
LOCAL_AI_ENERGY_EUR_KWH=
LOCAL_AI_MACHINE_EUR_HOUR=

# ─── Security ────────────────────────────────────────────────────
# [server-only]
COCKPIT_URL=https://cockpit.jsinnovia.com

# ─── Twilio (optional) ──────────────────────────────────────────
# [server-only]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── API Port ────────────────────────────────────────────────────
API_PORT=3001
