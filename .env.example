# JS-Innov.IA Cockpit — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles

# ── Agent jsinnovia-agent (Railway) ──────────────────────────────────────────
# URL du service backend Railway (proxy Supabase)
VITE_AGENT_URL=https://jsinnovia-agent-production.up.railway.app

# Clé d'auth pour x-agent-key header (legacy frontend — migration serveur prévue)
VITE_AGENT_KEY=your_agent_key_here

# Alias utilisé par base44Client.js (legacy frontend)
VITE_AGENT_AUTH=your_agent_key_here

# ── Page /agents-ia (Base44 Workspace API) ───────────────────────────────────
# Clé API workspace Base44 (legacy — ne pas utiliser pour les nouvelles intégrations)
VITE_BASE44_API_KEY=your_base44_workspace_api_key_here

# ── Cockpit API interne ───────────────────────────────────────────────────────
# URL du cockpit (pour les appels inter-services)
VITE_COCKPIT_API_URL=https://cockpit.jsinnovia.com

# Legacy frontend
VITE_AGENT_API_KEY=your_agent_key_here

# ── Webhook sync leads ────────────────────────────────────────────────────────
VITE_COCKPIT_WEBHOOK_URL=https://jsinnovia-agent-production.up.railway.app/webhook/leads

# ── Supabase (lecture publique uniquement — anon key) ────────────────────────
VITE_SUPABASE_URL=https://rzvvwcwyaddzsaattwqt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Base44 App ID ─────────────────────────────────────────────────────────────
VITE_APP_ID=69ff4dc771a2cdab275f8a00

# ── Assurances-Dour — SERVEUR UNIQUEMENT ─────────────────────────────────────
# Ne jamais préfixer ces secrets avec VITE_.
EMAIL_ASSURANCES_ADDRESS=info@assurances-dour.be
EMAIL_PASSWORD_ASSURANCES=your_ionos_mailbox_password_here
EMAIL_ASSURANCES_IMAP_HOST=imap.ionos.fr
EMAIL_ASSURANCES_IMAP_PORT=993
JSINNOVIA_AGENT_URL=https://jsinnovia-agent-production.up.railway.app
AGENT_API_KEY=your_server_only_agent_key_here

# Synchronisation automatique : désactivée par défaut.
# L'analyse manuelle depuis l'onglet Assurances-Dour fonctionne sans l'activer.
INSURANCE_EMAIL_SYNC_ENABLED=false
INSURANCE_EMAIL_SYNC_INTERVAL_MS=300000
INSURANCE_EMAIL_SYNC_BATCH=25
INSURANCE_PROXY_TIMEOUT_MS=20000
